{% comment %}
  Kinderfreundlicher Familienkalender. Private Plugin, Strategie „Plugin Merge“:
  nutzt die Termine des Apple-Kalender-Plugins (Variable apple_calendar_<ID>),
  die Daten verlassen TRMNL also nicht. Die ID des Quell-Plugins steht in der ersten assign-Zeile (cal).
  Termin-Titel „Name: Text“ werden als Namensschild + Text dargestellt.
  Feiertage Thüringen (plus Heiligabend/Silvester) 2026–2028 stehen fest in „holidays“,
  erzeugt mit Oster-Formel; für 2029 ff. ergänzen.
{% endcomment %}
{% assign cal = apple_calendar_75544 %}
{% assign offset = trmnl.user.utc_offset | default: 7200 %}
{% assign now_s = "now" | date: "%s" | plus: offset %}
{% assign today_key = now_s | date: "%Y-%m-%d" %}
{% assign wd = now_s | date: "%u" | plus: 0 %}
{% assign weekdays = "Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag,Sonntag" | split: "," %}
{% assign wd_short = "Mo,Di,Mi,Do,Fr,Sa,So" | split: "," %}
{% assign months = "Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember" | split: "," %}
{% assign month_idx = now_s | date: "%-m" | minus: 1 %}
{% assign wd_i = wd | minus: 1 %}
{% assign holidays = "2026-01-01=Neujahr;2026-04-03=Karfreitag;2026-04-05=Ostersonntag;2026-04-06=Ostermontag;2026-05-01=Tag der Arbeit;2026-05-14=Christi Himmelfahrt;2026-05-24=Pfingstsonntag;2026-05-25=Pfingstmontag;2026-09-20=Weltkindertag;2026-10-03=Tag der Deutschen Einheit;2026-10-31=Reformationstag;2026-12-24=Heiligabend;2026-12-25=1. Weihnachtstag;2026-12-26=2. Weihnachtstag;2026-12-31=Silvester;2027-01-01=Neujahr;2027-03-26=Karfreitag;2027-03-28=Ostersonntag;2027-03-29=Ostermontag;2027-05-01=Tag der Arbeit;2027-05-06=Christi Himmelfahrt;2027-05-16=Pfingstsonntag;2027-05-17=Pfingstmontag;2027-09-20=Weltkindertag;2027-10-03=Tag der Deutschen Einheit;2027-10-31=Reformationstag;2027-12-24=Heiligabend;2027-12-25=1. Weihnachtstag;2027-12-26=2. Weihnachtstag;2027-12-31=Silvester;2028-01-01=Neujahr;2028-04-14=Karfreitag;2028-04-16=Ostersonntag;2028-04-17=Ostermontag;2028-05-01=Tag der Arbeit;2028-05-25=Christi Himmelfahrt;2028-06-04=Pfingstsonntag;2028-06-05=Pfingstmontag;2028-09-20=Weltkindertag;2028-10-03=Tag der Deutschen Einheit;2028-10-31=Reformationstag;2028-12-24=Heiligabend;2028-12-25=1. Weihnachtstag;2028-12-26=2. Weihnachtstag;2028-12-31=Silvester" | split: ";" %}
{% assign today_holiday = "" %}
{% for h in holidays %}{% assign hp = h | split: "=" %}{% if hp[0] == today_key %}{% assign today_holiday = hp[1] %}{% endif %}{% endfor %}


<div style="display:flex; width:100%; height:100%; font-family:Inter, sans-serif; color:black; background:white;">

  <div style="width:250px; flex-shrink:0; background:black; color:white; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:0 14px; box-sizing:border-box;">
    <div style="font-size:30px; font-weight:800; letter-spacing:1px; text-transform:uppercase;">{{ weekdays[wd_i] }}</div>
    <div style="font-size:132px; font-weight:900; line-height:1; margin:2px 0;">{{ now_s | date: "%-d" }}</div>
    <div style="font-size:28px; font-weight:700;">{{ months[month_idx] }}</div>
    <div style="margin-top:14px; border:3px solid white; border-radius:22px; padding:4px 18px; font-size:22px; font-weight:800;">KW {{ now_s | date: "%V" | plus: 0 }}</div>
    <div style="margin-top:22px; font-size:18px; font-weight:700; line-height:1.3;">
      {% if wd >= 6 %}Wochenende! 🎉
      {% elsif wd == 5 %}Morgen ist<br>Wochenende! 🎉
      {% else %}{% assign left = 6 | minus: wd %}Noch {{ left }}× schlafen<br>bis zum Wochenende!{% endif %}
    </div>
  </div>

  <div style="flex:1; display:flex; flex-direction:column; padding:14px 20px 10px; box-sizing:border-box; min-width:0;">

    <div style="display:flex; align-items:center; gap:8px; font-size:17px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">☀️ Heute<span style="flex:1; height:3px; background:black;"></span></div>
    <div style="margin:8px 0 12px;">
      {% if today_holiday != "" %}
        <div style="display:inline-block; background:black; color:white; font-size:24px; font-weight:900; border-radius:10px; padding:3px 14px; margin:2px 0 4px;">🎉 Feiertag: {{ today_holiday }}</div>
      {% endif %}
      {% assign today_count = 0 %}
      {% for e in cal.events %}
        {% assign k = e.start_full | slice: 0, 10 %}
        {% if k == today_key and today_count < 4 %}
          {% assign today_count = today_count | plus: 1 %}
          {% assign who = "" %}{% assign title = e.summary %}
          {% if e.summary contains ":" %}
            {% assign parts = e.summary | split: ":" %}{% assign pre = parts[0] | strip %}
            {% if pre.size <= 10 %}{% unless pre contains " " %}{% assign who = pre %}{% assign title = e.summary | remove_first: parts[0] | remove_first: ":" | strip %}{% endunless %}{% endif %}
          {% endif %}
          {% assign t = e.summary | downcase %}
          {% assign ic = "📌" %}
          {% if t contains "fußball" or t contains "fussball" %}{% assign ic = "⚽" %}{% elsif t contains "schwimm" %}{% assign ic = "🏊" %}{% elsif t contains "zahnarzt" %}{% assign ic = "🦷" %}{% elsif t contains "arzt" %}{% assign ic = "🩺" %}{% elsif t contains "geburtstag" %}{% assign ic = "🎂" %}{% elsif t contains "hochzeit" %}{% assign ic = "💍" %}{% elsif t contains "essen" %}{% assign ic = "🍽️" %}{% elsif t contains "schule" or t contains "eltern" %}{% assign ic = "🏫" %}{% elsif t contains "musik" or t contains "klavier" or t contains "gitarre" %}{% assign ic = "🎵" %}{% elsif t contains "ferien" or t contains "urlaub" %}{% assign ic = "🏖️" %}{% elsif t contains "einkauf" %}{% assign ic = "🛒" %}{% elsif t contains "müll" or t contains "tonne" %}{% assign ic = "🗑️" %}{% elsif t contains "training" or t contains "sport" or t contains "turnen" %}{% assign ic = "🤸" %}{% elsif t contains "oma" or t contains "opa" %}{% assign ic = "👵" %}{% endif %}
          <div style="display:flex; align-items:center; gap:12px; padding:5px 0;">
            <span style="width:74px; font-size:{% if e.all_day %}16{% else %}24{% endif %}px; font-weight:900;">{% if e.all_day %}ganzer Tag{% else %}{{ e.start }}{% endif %}</span>
            <span style="font-size:26px; width:34px; text-align:center;">{{ ic }}</span>
            <span style="flex:1; font-size:25px; font-weight:700; line-height:1.1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">{{ title }}</span>
            {% if who != "" %}<span style="font-size:15px; font-weight:800; border:2.5px solid black; border-radius:14px; padding:1px 10px;">{{ who }}</span>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if today_count == 0 and today_holiday == "" %}
        <div style="font-size:24px; font-weight:700; padding:6px 0;">🧸 Heute steht nichts im Kalender – Zeit zum Spielen!</div>
      {% endif %}
    </div>

    <div style="display:flex; align-items:center; gap:8px; font-size:17px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">📅 Die nächsten 7 Tage<span style="flex:1; height:3px; background:black;"></span></div>
    <div style="flex:1; display:flex; flex-direction:column; justify-content:space-between; margin-top:4px;">
      {% for i in (1..7) %}
        {% assign day_s = i | times: 86400 | plus: now_s %}
        {% assign day_key = day_s | date: "%Y-%m-%d" %}
        {% assign dwd = day_s | date: "%u" | plus: 0 %}{% assign dwd_i = dwd | minus: 1 %}
        <div style="display:flex; align-items:baseline; gap:12px; padding:3px 0;{% unless forloop.last %} border-bottom:1.5px solid black;{% endunless %} font-size:22px; line-height:1.25;">
          <span style="font-weight:900; {% if dwd >= 6 %}background:black; color:white; border-radius:6px; padding:0 6px; width:74px;{% else %}width:86px;{% endif %}">{{ wd_short[dwd_i] }} {{ day_s | date: "%-d" }}.</span>
          <span style="flex:1; font-weight:600; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">
            {% assign n = 0 %}{% assign more = 0 %}
            {% for h in holidays %}{% assign hp = h | split: "=" %}{% if hp[0] == day_key %}<b style="font-weight:900;">🎉 {{ hp[1] }}</b>{% assign n = 1 %}{% endif %}{% endfor %}
            {% for e in cal.events %}
              {% assign k = e.start_full | slice: 0, 10 %}
              {% if k == day_key %}
                {% if n < 2 %}{% if n > 0 %} · {% endif %}{% unless e.all_day %}<b style="font-weight:900;">{{ e.start }}</b> {% endunless %}{{ e.summary }}{% else %}{% assign more = more | plus: 1 %}{% endif %}
                {% assign n = n | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% if more > 0 %} <b style="font-weight:900;">+{{ more }}</b>{% endif %}
            {% if n == 0 %}– nichts geplant –{% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
