<div class="layout" style="display:flex; flex-direction:column; height:100%;">
  <div class="title_bar">
    <span class="title">🌞 Gute Nachrichten</span>
    <span class="instance">{{ date | date: "%d.%m." }}</span>
  </div>

  <div style="flex:1; display:flex; flex-direction:column; justify-content:space-around; margin-top:6px;">
    {% for n in items %}
    <div>
      <div style="font-size:24px; font-weight:bold; line-height:1.15;">{{ n.title }}</div>
      <div style="font-size:16px; line-height:1.3; margin-top:3px;">{{ n.teaser }}</div>
    </div>
    {% endfor %}
  </div>

  <div style="border:3px solid black; border-radius:10px; padding:8px 12px; margin-top:6px; font-size:19px;">
    <b>😄 Witz des Tages:</b> {{ joke }}
  </div>
  <div style="font-size:10px; margin-top:4px;">Quelle: {{ source }}</div>
</div>
