<div class="layout" style="display:flex; flex-direction:column; height:100%;">
  <div class="title_bar">
    <span class="title">🇬🇧 Vokabeln · {{ topic }}</span>
    <span class="instance">{{ date | date: "%d.%m." }}</span>
  </div>

  <div style="flex:1; display:flex; flex-direction:column; justify-content:space-around; margin-top:4px;">
    {% for w in words %}
    <div style="padding:4px 0;{% unless forloop.last %} border-bottom:1px solid black;{% endunless %}">
      <div style="display:flex; align-items:baseline; gap:12px;">
        <span style="font-size:26px; font-weight:bold; line-height:1.1;">{{ w.en }}</span>
        <span style="font-size:12px; border:1.5px solid black; border-radius:6px; padding:1px 6px;">{{ w.type }}</span>
        <span style="flex:1; text-align:right; font-size:21px; line-height:1.1;">{{ w.de }}</span>
      </div>
      <div style="font-size:16px; font-style:italic; line-height:1.3; margin-top:2px;">„{{ w.example }}“</div>
    </div>
    {% endfor %}
  </div>
</div>
