<div class="layout" style="display:flex; flex-direction:column; align-items:stretch; width:100%; height:100%; padding:6px 10px; box-sizing:border-box;">
  <div style="display:flex; align-items:center; gap:10px;">
    <svg width="78" height="78" style="flex-shrink:0;"><use href="#w-{{ main }}" width="78" height="78"/></svg>
    <div style="line-height:1.1;">
      <div style="font-size:44px; font-weight:bold;">{{ current.temperature_2m | round }}°</div>
      <div style="font-size:16px;">today {{ tmin }}° to <b>{{ tmax }}°</b></div>
    </div>
  </div>
  <div style="font-size:16px; font-weight:bold; line-height:1.25; margin-top:4px;">{{ phrase }}</div>
  <div style="margin-top:auto; font-size:15px; line-height:1.25; border-top:2px solid black; padding-top:3px;"><b>Tonight {{ b_icon }}</b> down to {{ n_min }}° · rain {{ n_rain }}% · {{ n_sky }}</div>
</div>
