{% comment %}Stundenplan, ganze Seite: je Tag eine einfache Tabelle, eine Zeile pro Stunde. Braucht den Shared-Teil.{% endcomment %}
{% assign hat_geaendert = false %}
{% assign hat_hausaufgaben = false %}{% if hausaufgaben %}{% assign hat_hausaufgaben = true %}{% endif %}
{% comment %}Schriftgröße nach Platzbedarf (bis 8 Stunden, dazu Hausaufgaben){% endcomment %}
{% assign max_n = 0 %}{% for t in tage limit: 2 %}{% assign n = t.stunden | size %}{% if n > max_n %}{% assign max_n = n %}{% endif %}{% endfor %}
{% assign fs = 24 %}{% if max_n > 6 %}{% assign fs = 22 %}{% endif %}{% if max_n > 7 %}{% assign fs = 19 %}{% endif %}
{% assign ha_max = 3 %}{% if hat_hausaufgaben %}{% assign fs = fs | minus: 3 %}{% if max_n > 6 %}{% assign ha_max = 2 %}{% endif %}{% endif %}
{% comment %}Stand immer als echtes Datum, auch wenn die Daten ein paar Tage alt sind{% endcomment %}
{% if stand %}{% assign stand_datum = stand | date: "%-d.%-m. %H:%M" %}{% else %}{% assign stand_datum = stand_text | default: "" %}{% endif %}
<div style="display:flex; flex-direction:column; width:100%; height:100%; padding:12px 18px 10px; box-sizing:border-box; font-family:Inter, sans-serif; color:black; background:white;">
  <div style="display:flex; align-items:center; gap:10px; font-size:17px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">
    🎒 Stundenplan · {{ name }}<span style="flex:1; height:3px; background:black;"></span>
    {% if veraltet %}<span style="font-size:15px; letter-spacing:0; text-transform:none; border:2.5px solid black; border-radius:10px; padding:1px 8px;">Stand: {{ stand_datum }}</span>{% elsif stand_datum != "" %}<span style="font-size:14px; font-weight:600; letter-spacing:0; text-transform:none;">Stand: {{ stand_datum }}</span>{% endif %}
  </div>

  <div style="flex:1; display:flex; gap:16px; margin-top:8px; min-height:0;">
    {% for t in tage limit: 2 %}
    <div style="flex:1; display:flex; flex-direction:column; min-width:0; border:3px solid black; border-radius:14px; overflow:hidden;">
      <div style="background:black; color:white; padding:5px 12px; font-size:21px; font-weight:900;">{{ t.titel }}</div>
      <table style="width:100%; border-collapse:collapse; flex:1;">
        {% for s in t.stunden %}
          {% if s.geaendert %}{% assign hat_geaendert = true %}{% endif %}
          {% assign fname = s.fach %}{% assign ic = "📚" %}
          {% for c in fach_codes %}{% if c == s.fach %}{% assign fname = fach_namen[forloop.index0] %}{% assign ic = fach_icons[forloop.index0] %}{% endif %}{% endfor %}
          <tr style="{% unless forloop.last %}border-bottom:1.5px solid black;{% endunless %}">
            <td style="width:34px; text-align:right; padding:0 8px 0 6px; font-size:{{ fs }}px; font-weight:900; vertical-align:middle;">{{ s.nr }}.</td>
            <td style="width:30px; font-size:{{ fs | minus: 2 }}px; vertical-align:middle;">{{ ic }}</td>
            <td style="padding:2px 6px; font-size:{{ fs }}px; line-height:1.15; vertical-align:middle;">
              {% if s.ausfall %}
                <span style="font-weight:800; text-decoration:line-through; text-decoration-thickness:2px;">{{ fname }}</span> <span style="font-size:{{ fs | minus: 6 }}px; font-weight:900; background:black; color:white; border-radius:6px; padding:0 6px; white-space:nowrap;">fällt aus</span>
              {% else %}
                <span style="font-weight:800;">{{ fname }}{% if s.geaendert %}*{% endif %}</span> <span style="font-size:{{ fs | minus: 5 }}px; font-weight:700;">({{ s.fach }})</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
  </div>

  {% if hat_hausaufgaben %}
  <div style="margin-top:8px; border:3px solid black; border-radius:14px; padding:5px 14px;">
    <div style="font-size:16px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">📝 Hausaufgaben</div>
    {% assign ha_n = hausaufgaben | size %}
    {% if ha_n == 0 %}
      <div style="font-size:20px; font-weight:800; margin-top:2px;">Keine Hausaufgaben. Hurra! 🎉</div>
    {% else %}
      {% for h in hausaufgaben limit: ha_max %}
        {% assign hname = h.fach %}{% for c in fach_codes %}{% if c == h.fach %}{% assign hname = fach_namen[forloop.index0] %}{% endif %}{% endfor %}
        <div style="display:flex; align-items:baseline; gap:10px; font-size:19px; line-height:1.3; margin-top:1px;">
          <span style="font-weight:900; white-space:nowrap;">{{ hname }}</span>
          {% comment %}„zum 01.10.2026“ am Ende weglassen, das Fälligkeitsschild zeigt den Termin schon{% endcomment %}
          {% assign htext = h.text %}{% assign hparts = h.text | split: " zum " %}
          {% if hparts.size > 1 %}{% assign hlast = hparts | last %}{% assign hdigits = hlast | remove: "." | remove: " " %}{% assign hnum = hdigits | plus: 0 %}
            {% assign hlen = hlast | size %}{% if hlen < 11 and hnum > 0 %}{% if hlast contains "." %}{% assign cut = " zum " | append: hlast %}{% assign htext = h.text | remove_last: cut %}{% endif %}{% endif %}
          {% endif %}
          <span style="flex:1; font-weight:600; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">{{ htext }}</span>
          {% if h.faellig_text %}<span style="font-size:15px; font-weight:900; border:2px solid black; border-radius:10px; padding:0 8px; white-space:nowrap;">bis {{ h.faellig_text }}</span>{% endif %}
        </div>
      {% endfor %}
      {% if ha_n > ha_max %}<div style="font-size:15px; font-weight:800;">und {{ ha_n | minus: ha_max }} weitere</div>{% endif %}
    {% endif %}
  </div>
  {% endif %}
  {% if hat_geaendert %}<div style="font-size:15px; font-weight:700; margin-top:4px;">* verlegt oder anderes Fach</div>{% endif %}
</div>
