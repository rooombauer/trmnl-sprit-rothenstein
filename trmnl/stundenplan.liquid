{% comment %}Stundenplan, ganze Seite. Braucht den Shared-Teil (stundenplan_shared.liquid).{% endcomment %}
{% assign hat_geaendert = false %}
{% assign hat_hausaufgaben = false %}{% if hausaufgaben %}{% assign hat_hausaufgaben = true %}{% endif %}
<div style="display:flex; flex-direction:column; width:100%; height:100%; padding:12px 20px 10px; box-sizing:border-box; font-family:Inter, sans-serif; color:black; background:white;">
  <div style="display:flex; align-items:center; gap:10px; font-size:17px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">
    🎒 Schultag · {{ name }}<span style="flex:1; height:3px; background:black;"></span>
    {% if veraltet %}<span style="font-size:15px; letter-spacing:0; text-transform:none; border:2.5px solid black; border-radius:10px; padding:1px 8px;">Stand: {{ stand_text }}</span>{% endif %}
  </div>

  <div style="flex:1; display:flex; gap:22px; margin-top:8px; min-height:0;">
    {% for t in tage limit: 2 %}
    <div style="flex:1; display:flex; flex-direction:column; min-width:0; border:3px solid black; border-radius:16px; overflow:hidden;">
      <div style="background:black; color:white; padding:5px 14px; font-size:21px; font-weight:900;">{{ t.titel }}</div>
      <div style="flex:1; display:flex; flex-direction:column; justify-content:space-evenly; padding:2px 12px;">
        {% assign n = t.stunden | size %}
        {% assign paar_offen = false %}{% for s in t.stunden %}
          {% assign i = forloop.index0 %}{% assign prev_i = i | minus: 1 %}{% assign next_i = i | plus: 1 %}
          {% assign prev = t.stunden[prev_i] %}{% assign next = t.stunden[next_i] %}
          {% comment %}Doppelstunden: jeweils zwei gleiche Stunden hintereinander zu einer Zeile zusammenfassen{% endcomment %}
          {% assign gleich_vorher = false %}{% if i > 0 and prev.fach == s.fach and prev.ausfall == s.ausfall and prev.nr != s.nr and prev.geaendert == s.geaendert %}{% assign gleich_vorher = true %}{% endif %}
          {% if gleich_vorher and paar_offen %}{% assign paar_offen = false %}{% continue %}{% endif %}
          {% assign doppel = false %}
          {% if next and next.fach == s.fach and next.ausfall == s.ausfall and next.nr != s.nr and next.geaendert == s.geaendert %}{% assign doppel = true %}{% endif %}
          {% assign paar_offen = doppel %}
          {% if s.geaendert %}{% assign hat_geaendert = true %}{% endif %}
          {% assign ic = "📚" %}{% for c in fach_codes %}{% if c == s.fach %}{% assign ic = fach_icons[forloop.index0] %}{% endif %}{% endfor %}
          <div style="display:flex; align-items:center; gap:10px; padding:2px 0;">
            <span style="width:44px; text-align:right; font-size:17px; font-weight:800;">{% if doppel %}{{ s.nr }}+{{ next.nr }}{% else %}{{ s.nr }}.{% endif %}</span>
            <span style="font-size:24px; width:32px; text-align:center;">{{ ic }}</span>
            {% if s.ausfall %}
              <span style="font-size:30px; font-weight:900; line-height:1.1; text-decoration:line-through; text-decoration-thickness:3px;">{{ s.fach }}</span>
              <span style="font-size:16px; font-weight:900; background:black; color:white; border-radius:8px; padding:1px 8px;">fällt aus</span>
            {% else %}
              <span style="font-size:30px; font-weight:900; line-height:1.1;">{{ s.fach }}{% if s.geaendert %}*{% endif %}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  {% if hat_hausaufgaben %}
  <div style="margin-top:8px; border:3px solid black; border-radius:16px; padding:6px 14px;">
    <div style="font-size:17px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">📝 Hausaufgaben</div>
    {% assign ha_n = hausaufgaben | size %}
    {% if ha_n == 0 %}
      <div style="font-size:21px; font-weight:800; margin-top:2px;">Keine Hausaufgaben. Hurra! 🎉</div>
    {% else %}
      {% for h in hausaufgaben limit: 3 %}
        {% assign ic = "📚" %}{% for c in fach_codes %}{% if c == h.fach %}{% assign ic = fach_icons[forloop.index0] %}{% endif %}{% endfor %}
        <div style="display:flex; align-items:baseline; gap:10px; font-size:20px; line-height:1.3; margin-top:2px;">
          <span style="font-weight:900; white-space:nowrap;">{{ ic }} {{ h.fach }}</span>
          <span style="flex:1; font-weight:600; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;">{{ h.text }}</span>
          {% if h.faellig_text %}<span style="font-size:15px; font-weight:900; border:2px solid black; border-radius:10px; padding:0 8px; white-space:nowrap;">bis {{ h.faellig_text }}</span>{% endif %}
        </div>
      {% endfor %}
      {% if ha_n > 3 %}<div style="font-size:15px; font-weight:800;">und {{ ha_n | minus: 3 }} weitere</div>{% endif %}
    {% endif %}
  </div>
  {% endif %}
  {% if hat_geaendert %}<div style="font-size:15px; font-weight:700; margin-top:4px;">* verlegt oder anderes Fach</div>{% endif %}
</div>
