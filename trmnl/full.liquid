<div class="layout" style="display:flex; align-items:center; gap:28px; padding:0 8px; font-family:Inter, sans-serif;">

  <div style="flex:1; display:flex; flex-direction:column;">
    <div style="font-size:14px; letter-spacing:2px; text-transform:uppercase; margin-bottom:6px;">Super E5</div>
    {% for s in stations %}
    <div style="display:flex; align-items:center; gap:14px; padding:15px 0;{% unless forloop.last %} border-bottom:1px solid black;{% endunless %}">
      <div style="width:26px; height:26px; border-radius:13px; background:black; color:white; font-size:15px; font-weight:bold; display:flex; align-items:center; justify-content:center; flex-shrink:0;">{{ s.n }}</div>
      <div style="flex:1; min-width:0;">
        <div style="font-size:22px; font-weight:bold; line-height:1.15; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ s.brand }}</div>
        <div style="font-size:13px; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ s.place }} · {{ s.dist }}{% unless s.open %} · geschlossen{% endunless %}</div>
      </div>
      <div style="text-align:right; line-height:1; white-space:nowrap;{% unless s.open %} opacity:0.4;{% endunless %}">
        <span style="font-size:44px; font-weight:{% if s.cheapest %}800{% else %}400{% endif %}; letter-spacing:-1px;">{{ s.price_main }}</span><span style="font-size:22px; font-weight:{% if s.cheapest %}800{% else %}400{% endif %}; vertical-align:20px;">{{ s.price_sup }}</span>
      </div>
    </div>
    {% endfor %}
  </div>

  <svg width="{{ karte.size }}" height="{{ karte.size }}" viewBox="0 0 {{ karte.size }} {{ karte.size }}" style="flex-shrink:0; font-family:Inter, sans-serif;">
    <image href="{{ karte.image }}" x="0" y="0" width="{{ karte.size }}" height="{{ karte.size }}" />
    <rect x="0.5" y="0.5" width="{{ karte.size | minus: 1 }}" height="{{ karte.size | minus: 1 }}" fill="none" stroke="black" stroke-width="1" />

    {% for o in karte.others %}
    <circle cx="{{ o.x }}" cy="{{ o.y }}" r="5" fill="white" stroke="black" stroke-width="2" />
    <text x="{{ o.lx }}" y="{{ o.ly }}" font-size="13" text-anchor="{{ o.anchor }}" stroke="white" stroke-width="4" stroke-linejoin="round" paint-order="stroke"><tspan font-weight="bold">{{ o.brand }}</tspan> {{ o.price_main }}<tspan font-size="9" dy="-5">{{ o.price_sup }}</tspan></text>
    {% endfor %}

    {% for p in karte.near %}
    <circle cx="{{ p.x }}" cy="{{ p.y }}" r="11" fill="black" stroke="white" stroke-width="2" />
    <text x="{{ p.x }}" y="{{ p.y }}" dy="4.5" font-size="13" font-weight="bold" fill="white" text-anchor="middle">{{ p.n }}</text>
    {% endfor %}

    <g transform="translate({{ karte.cx }},{{ karte.cy }})">
      <path d="M-8,-1 L0,-9 L8,-1 L8,8 L-8,8 Z" fill="white" stroke="black" stroke-width="2" stroke-linejoin="round" />
      <rect x="-2" y="2" width="4" height="6" fill="black" />
    </g>

    <g transform="translate(16,22)">
      <path d="M0,-12 L6,4 L0,0 L-6,4 Z" fill="black" />
      <text x="0" y="16" font-size="11" font-weight="bold" text-anchor="middle">N</text>
    </g>
    <text x="{{ karte.size | minus: 4 }}" y="{{ karte.size | minus: 5 }}" font-size="8" text-anchor="end" stroke="white" stroke-width="3" paint-order="stroke">Karte © OpenStreetMap-Mitwirkende</text>
  </svg>

</div>

<div class="title_bar">
  <span class="title">Sprit · Rothenstein</span>
  <span class="instance">Stand {{ updated_local }} · Tankerkönig / MTS-K, CC BY 4.0</span>
</div>
