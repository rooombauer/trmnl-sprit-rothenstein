{% comment %}Heutigen Tag per Datum wählen (Daten enthalten mehrere Tage im Voraus){% endcomment %}
{% assign today_key = "now" | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}
{% if days[today_key] %}{% assign words = days[today_key].words %}{% assign date = today_key %}{% endif %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;700&display=swap">
<div class="layout" style="display:flex; flex-direction:column; align-items:stretch; height:100%; width:100%;">
  <div class="title_bar">
    <span class="title">📗 Vokabeln · {{ topic }}</span>
    <span class="instance">{{ date | date: "%d.%m." }}</span>
  </div>

  <div style="flex:1; width:100%; display:flex; flex-direction:column; justify-content:space-around; margin-top:2px; padding:0 12px; box-sizing:border-box;">
    {% for w in words limit: 4 %}
    <div style="display:flex; align-items:center; gap:24px; padding:4px 0;{% unless forloop.last %} border-bottom:1px solid black;{% endunless %}">
      <div style="flex:1; min-width:0;">
        <div style="display:flex; align-items:baseline; gap:8px;">
          <span style="font-size:28px; font-weight:bold; line-height:1.15;">{{ w.de }}</span>
          <span style="font-size:13px; border:1.5px solid black; border-radius:6px; padding:0 6px;">{{ w.type }}</span>
        </div>
        <div style="font-size:18px; line-height:1.3;"><i>{{ w.tr }}</i>{% if w.extra != "" %} · <span dir="ltr" style="unicode-bidi:isolate; font-family:'Noto Naskh Arabic', serif; font-size:22px;">{{ w.extra }}</span>{% endif %}</div>
        <div style="font-size:17px; line-height:1.3; font-style:italic;">„{{ w.ex_de }}“</div>
      </div>
      <div dir="rtl" style="flex:1; text-align:right; font-family:'Noto Naskh Arabic', serif;">
        <div style="font-size:48px; font-weight:bold; line-height:1.2;">{{ w.ar }}</div>
        <div style="font-size:27px; line-height:1.3;">{{ w.ex_ar }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>
