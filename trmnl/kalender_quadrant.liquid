<div style="display:flex; flex-direction:column; width:100%; height:100%; font-family:Inter, sans-serif; color:black; background:white; padding:8px 12px; box-sizing:border-box;">
  <div style="display:flex; align-items:center; gap:10px; background:black; color:white; border-radius:10px; padding:4px 12px;">
    <span style="font-size:40px; font-weight:900; line-height:1;">{{ now_s | date: "%-d" }}</span>
    <span style="font-size:17px; font-weight:800; line-height:1.15;">{{ weekdays[wd_i] }}<br>{{ months[month_idx] }} · KW {{ now_s | date: "%V" | plus: 0 }}</span>
  </div>
  <div style="flex:1; display:flex; flex-direction:column; justify-content:center; gap:3px; margin-top:4px;">
    {% if today_holiday != "" %}<div style="font-size:18px; font-weight:900;">🎉 {{ today_holiday }}</div>{% endif %}
    {% if ferien_today != "" %}<div style="font-size:18px; font-weight:900;">🏖️ {{ ferien_today }}</div>{% endif %}
    {% assign qn = 0 %}
    {% for e in cal.events %}
      {% assign k = e.start_full | slice: 0, 10 %}
      {% if k == today_key and qn < 3 %}
        {% assign qn = qn | plus: 1 %}
        <div style="font-size:18px; font-weight:700; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{% unless e.all_day %}<b style="font-weight:900;">{{ e.start }}</b> {% endunless %}{{ e.summary }}</div>
      {% endif %}
    {% endfor %}
    {% if qn == 0 and today_holiday == "" and ferien_today == "" %}<div style="font-size:18px; font-weight:700;">🧸 Heute nichts im Kalender</div>{% endif %}
  </div>
</div>
