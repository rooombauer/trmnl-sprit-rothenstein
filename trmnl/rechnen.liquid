{% comment %}Heutigen Tag per Datum wählen (Daten enthalten mehrere Tage im Voraus){% endcomment %}
{% assign today_key = "now" | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}
{% if days[today_key] %}{% assign tasks = days[today_key].tasks %}{% assign yesterday = days[today_key].yesterday %}{% assign date = today_key %}{% endif %}
<div class="layout" style="display:flex; flex-direction:column; height:100%;">
  <div class="title_bar">
    <span class="title">✏️ Rechnen · {{ topic }}</span>
    <span class="instance">{{ date | date: "%d.%m." }}</span>
  </div>

  <div style="display:flex; flex:1; gap:24px; margin-top:10px;">
    <div style="flex:3; display:flex; flex-direction:column; justify-content:space-around;">
      {% for t in tasks %}
      <div style="display:flex; align-items:baseline; font-size:52px; font-weight:bold; line-height:1;">
        <span style="font-size:22px; width:40px;">{{ forloop.index }}.</span>
        <span style="width:90px; text-align:right;">{{ t.a }}</span>
        <span style="width:70px; text-align:center;">×</span>
        <span style="width:90px; text-align:left;">{{ t.b }}</span>
        <span style="width:60px; text-align:center;">=</span>
        <span style="flex:1; border-bottom:4px solid black; height:44px;"></span>
      </div>
      {% endfor %}
    </div>

    <div style="flex:1; border-left:2px solid black; padding-left:16px; display:flex; flex-direction:column; justify-content:center;">
      <div style="font-size:15px; font-weight:bold; margin-bottom:8px;">Lösungen von gestern</div>
      {% for t in yesterday.tasks %}
      <div style="font-size:20px; line-height:1.6;">{{ t.a }} × {{ t.b }} = <b>{{ t.result }}</b></div>
      {% endfor %}
    </div>
  </div>
</div>
