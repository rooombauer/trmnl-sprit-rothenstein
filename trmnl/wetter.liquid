<div class="layout" style="display:flex; flex-direction:column; align-items:stretch; width:100%; height:100%;">
  <div class="title_bar">
    <span class="title">Weather in Rothenstein</span>
    <span class="instance">{{ current.time | date: "%d.%m." }}</span>
  </div>

  <div style="flex:1; display:flex; align-items:center; gap:20px; padding:0 18px;">
    <svg width="180" height="180" style="flex-shrink:0;"><use href="#w-{{ main }}" width="180" height="180"/></svg>
    <div style="flex:1;">
      <div style="font-size:24px; font-weight:bold; line-height:1.25;">{{ phrase }}</div>
      <div style="display:flex; align-items:baseline; gap:16px; margin-top:8px;">
        <span style="font-size:60px; font-weight:bold; line-height:1;">{{ current.temperature_2m | round }}°</span>
        <span style="font-size:20px; line-height:1.3;">now<br>today {{ tmin }}° to <b>{{ tmax }}°</b></span>
      </div>
      <div style="margin-top:8px; font-size:19px; line-height:1.3;">
        {% if tmax < 5 %}🧤 Winter coat, hat and gloves{% elsif tmax < 12 %}🧥 Warm jacket and jumper{% elsif tmax < 18 %}🧶 Jumper or light jacket{% elsif tmax < 24 %}👕 T-shirt, plus a jumper{% else %}🩳 T-shirt and shorts{% endif %}{% if tmorning < 12 and tmax >= 12 %} · cool morning ({{ tmorning }}°){% endif %}{% if rain >= 50 %} · ☂️ rain {{ rain }}%{% endif %}{% if uv >= 6 %} · 🧴 sunscreen{% endif %}
      </div>
    </div>
  </div>

  <div style="display:flex; align-items:center; gap:14px; border:3px solid black; border-radius:12px; margin:4px 14px 6px; padding:6px 14px;">
    <svg width="48" height="48" style="flex-shrink:0;"><use href="#w-{{ n_cat }}" width="48" height="48"/></svg>
    <div style="flex:1; line-height:1.25;">
      <div style="font-size:21px; font-weight:900;">Tonight {{ b_icon }} {{ balcony }}</div>
      <div style="font-size:18px;">{{ n_eve }}° at 10 pm, down to <b>{{ n_min }}°</b> · rain {{ n_rain }}% · wind {{ n_wind }} km/h · {{ n_sky }}</div>
    </div>
  </div>
</div>
