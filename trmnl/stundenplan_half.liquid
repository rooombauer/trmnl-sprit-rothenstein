{% comment %}
  Stundenplan als halbe Seite (Half Horizontal, 800×240) für die Frühstücksseite:
  nur der erste Tag aus den Daten (heute bzw. nächster Schultag), als Tabelle mit einer Spalte je Stunde.
  Braucht den Shared-Teil.
{% endcomment %}
{% assign t = tage[0] %}
{% comment %}Stand immer als echtes Datum, auch wenn die Daten ein paar Tage alt sind{% endcomment %}
{% if stand %}{% assign stand_datum = stand | date: "%-d.%-m. %H:%M" %}{% else %}{% assign stand_datum = stand_text | default: "" %}{% endif %}
<div style="display:flex; flex-direction:column; width:100%; height:100%; padding:6px 12px; box-sizing:border-box; font-family:Inter, sans-serif; color:black; background:white;">
  <div style="display:flex; align-items:center; gap:10px; font-size:15px; font-weight:900; letter-spacing:2px; text-transform:uppercase;">
    🎒 {{ name }} · {{ t.titel }}<span style="flex:1; height:3px; background:black;"></span>
    {% if veraltet %}<span style="font-size:13px; letter-spacing:0; text-transform:none; border:2px solid black; border-radius:8px; padding:0 6px;">Stand: {{ stand_datum }}</span>{% elsif stand_datum != "" %}<span style="font-size:12px; font-weight:600; letter-spacing:0; text-transform:none;">Stand: {{ stand_datum }}</span>{% endif %}
  </div>
  {% if t.info and t.info != "" %}{% assign info_zeilen = t.info | strip | newline_to_br | split: "<br />" %}<div style="font-size:14px; font-weight:900; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">ℹ️ {{ info_zeilen | first | strip }}</div>{% endif %}
  <table style="width:100%; flex:1; border-collapse:collapse; table-layout:fixed; margin-top:6px;">
    <tr>
      {% for s in t.stunden %}
        {% assign fname = s.fach %}{% assign ic = "📚" %}
        {% for c in fach_codes %}{% if c == s.fach %}{% assign fname = fach_namen[forloop.index0] %}{% assign ic = fach_icons[forloop.index0] %}{% endif %}{% endfor %}
        <td style="border:2.5px solid black; text-align:center; vertical-align:top; padding:4px 3px;{% if s.ausfall %} background:black; color:white;{% endif %}">
          <div style="font-size:18px; font-weight:900;">{{ s.nr }}.</div>
          <div style="font-size:22px;">{{ ic }}</div>
          <div style="font-size:16px; font-weight:800; line-height:1.15;{% if s.ausfall %} text-decoration:line-through;{% endif %}">{{ fname }}{% if s.geaendert %}*{% endif %}</div>
          {% if s.geaendert and s.hinweis and s.hinweis != "" %}<div style="font-size:12px; font-weight:900; line-height:1.15;">{{ s.hinweis | truncate: 24, "…" }}</div>{% else %}<div style="font-size:14px; font-weight:700;">({{ s.fach }})</div>{% endif %}
          {% if s.ausfall %}<div style="font-size:14px; font-weight:900;">fällt aus</div>{% endif %}
        </td>
      {% endfor %}
    </tr>
  </table>
  {% if hausaufgaben and hausaufgaben.size > 0 %}
  <div style="font-size:16px; font-weight:800; margin-top:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">📝 Hausaufgaben: {% for h in hausaufgaben %}{% assign hname = h.fach %}{% for c in fach_codes %}{% if c == h.fach %}{% assign hname = fach_namen[forloop.index0] %}{% endif %}{% endfor %}{{ hname }}{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
  {% endif %}
</div>
