<div class="layout" style="display:flex; flex-direction:column; align-items:stretch; width:100%; height:100%;">
  <div class="title_bar">
    <span class="title">✏️ Rechnen · {{ topic }}</span>
  </div>

  <div style="flex:1; display:flex; flex-direction:column; justify-content:space-around; padding:4px 14px 0; box-sizing:border-box;">
    {% for t in tasks %}
    <div style="display:flex; align-items:baseline; font-size:40px; font-weight:bold; line-height:1;">
      <span style="width:66px; text-align:right;">{{ t.a }}</span>
      <span style="width:46px; text-align:center;">×</span>
      <span style="width:58px; text-align:left;">{{ t.b }}</span>
      <span style="width:40px; text-align:center;">=</span>
      <span style="flex:1; border-bottom:3px solid black; height:34px;"></span>
    </div>
    {% endfor %}
  </div>

  <div style="border-top:1.5px solid black; margin:6px 14px 0; padding-top:4px; font-size:13px; line-height:1.35;">
    <b>Gestern:</b>
    {% for t in yesterday.tasks %}{{ t.a }}×{{ t.b }}=<b>{{ t.result }}</b>{% unless forloop.last %} · {% endunless %}{% endfor %}
  </div>
</div>
